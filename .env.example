PORT=5000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
FRONTEND_URL=https://habbitracker-frontend.vercel.app
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
# Password reset email
RESEND_API_KEY=replace_with_new_resend_api_key
MAIL_FROM="Habit Tracker <no-reply@your-verified-domain.com>"
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_EXPIRY_MINUTES=10

# Rate limiting
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
USER_WRITE_RATE_LIMIT_WINDOW_MS=900000
USER_WRITE_RATE_LIMIT_MAX=120

# Login lockout
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_IP_MAX_FAILED_ATTEMPTS=20
LOGIN_LOCK_MINUTES=15
LOGIN_ATTEMPT_TTL_HOURS=24

# In-memory cache (private finance and habit responses are not cached)
CACHE_MAX_ENTRIES=500
CACHE_TTL_SECONDS=45
CACHE_MAX_SIZE_BYTES=5242880

# Idempotency
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_MAX_RESPONSE_BYTES=131072
IDEMPOTENCY_MAX_RECORDS_PER_USER=200
IDEMPOTENCY_KEY_MAX_LENGTH=200

# List and document caps
PAGINATION_DEFAULT_LIMIT=50
PAGINATION_MAX_LIMIT=100
TASKS_HARD_CAP=2000
HABITS_HARD_CAP=1000
HABIT_LOGS_HARD_CAP=5000
FINANCE_CATEGORIES_HARD_CAP=500
FINANCE_ITEMS_HARD_CAP=1000
GOALS_HARD_CAP=500

# MongoDB Atlas connection pool and timeouts
MONGO_MAX_POOL_SIZE=5
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_MAX_IDLE_TIME_MS=30000

# HTTP
HTTP_REQUEST_TIMEOUT_MS=120000
SHUTDOWN_TIMEOUT_MS=10000
JSON_BODY_LIMIT=100kb
COMPRESSION_LEVEL=1
COMPRESSION_THRESHOLD_BYTES=1024
